; MEWD, the Godot 4 port. The project is the repository's root so the
; game's own assets/ are res://assets/ without a copy; tools/ carries a
; .gdignore.

config_version=5

[application]

config/name="MEWD"
config/description="MEWD — Made Entirely Without Doom"
config/version="0000033"
run/main_scene="res://godot/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
; Android's Back (a handheld's Select, often) pauses, never quits
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.043, 0.075, 0.078, 1)
boot_splash/image="res://godot/data/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

; THE ISLAND'S BAKES (godot/island/, from golf): the terrain's chunk meshes
; and the vegetation's instance buffers, read off disk instead of generated
TerrainBake="*res://godot/island/scripts/autoload/AUTOLOAD_terrain_bake.gd"
VegBake="*res://godot/island/scripts/autoload/AUTOLOAD_veg_bake.gd"

[audio]

; THE STANDALONE SERVER (export preset "Linux Server", feature `server`):
; no sound card wanted
driver/driver.server="Dummy"

[display]

; and no window: the headless display server, as --headless gives
display_server/driver.server="headless"

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; a handheld is held sideways, either way round
window/handheld/orientation=4

[rendering]

; MOBILE, at the user's request, for real decals (Decal nodes, which
; Compatibility has not got): on the desktop and on Android alike.
; Everything is drawn unlit, so Forward+'s clustered lights and sky
; radiance would buy nothing. The web is always Compatibility (Godot's
; rule), and there the decals are the quads they were (Decals.real).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=true
; real decals (RealDecals) are chunky pixels like everything else
textures/decals/filter=0
; Android wants its textures in ETC2/ASTC (the APK, tools/build-android.sh)
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0

