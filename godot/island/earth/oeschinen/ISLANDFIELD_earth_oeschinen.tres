[gd_resource type="Resource" script_class="EarthField" load_steps=2 format=3]

; OESCHINENSEE, Bernese Oberland, Switzerland (46.4986 N, 7.7270 E): a 3 km
; square round the lake under the Bluemlisalp, out of open data by
; tools/earth_fetch.py (region.json says which, and the attribution it owes).
;
; An EarthField: golf's island field answering out of the region's grids
; (SCRIPT_earth_field.gd). One square hub the region's size (hub_radius is half
; its side), no satellites, no coast wobble, every golf feature off, and the
; cliff's rounded lip off too (cliff_shoulder_height 0): the square ends in a
; clean cut face. tools/earth_fetch.py --register writes one of these for a new
; region by copying this one.

[ext_resource type="Script" path="res://godot/island/scripts/world/SCRIPT_earth_field.gd" id="1_field"]

