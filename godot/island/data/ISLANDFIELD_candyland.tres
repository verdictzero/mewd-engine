[gd_resource type="Resource" script_class="IslandField" load_steps=2 format=3]

[ext_resource type="Script" path="res://godot/island/scripts/world/SCRIPT_island_field.gd" id="1_field"]

; MEWD's CANDY LAND, at the user's request: ISLAND 0's ground (golf's
; island_0, seed 1337, the same size and hills) with a road network on
; it. Copied from ISLANDFIELD_island0.tres with these changed:
;   * zone_enabled = true, holes_max = 0   zones on, but no golf: only
;     build pads, which are the towns' squares
;   * build_pads_max = 10, build_area_fraction = 0.10   fewer squares
;   * build_pad_radius 18..32 m, zone_apron_ratio 0.5, zone_apron_min 10 m,
;     zone_lift_spread 0, zone_irregularity 0   SMALL, DELIBERATELY FLAT
;     squares (at the user's request): dead level, round, cut into the
;     hillside with a steep bank of half their radius (10 m at least),
;     the roads running into them; and the roads' edges straight
;   * square_pads = true, square_apron 60 m, build_pad_radius 30..36 m
;     THE TOWNS ARE SQUARES (at the user's request: "flat squares, a road
;     intersection, no hills, cut out of the surrounding terrain using
;     cliffs, divided into quadrants, 4 houses per quadrant"): each a dead
;     level square 60 to 72 m across, its sides along the line to its
;     nearest neighbour, banked over 30 m (it was 1.5 m, then 16; at the
;     user's request, a gentler bank) where the ground round it is
;     higher, with a cross of streets through its
;     middle that every road leaves from (IslandField.square_pads); the
;     houses four to a quadrant (IslandLevel.place_houses)
;   * square_bank 160 m, path_bank 40 m   THE LAND EASED DOWN TO THE TOWNS
;     AND THE ROADS (at the user's request: "smooth out terrain around
;     towns and roads EVEN MORE like a lot more, no jaggedness"): the hills
;     come down to a town over 160 m and to a road over 40 m either side
;     (Zone.bank), the verges, plants and splat keeping their aprons; where
;     banks overlap their shelves blend (IslandField.zone_at), and a town's
;     bank rounds its corners
;   * green_undulation 0, green_micro 0   the golf green's swell and grain
;     left off every groomed shelf: the towns and the roads dead level
;   * path_enabled = true   golf's graded tracks joining the squares (a
;     minimum spanning tree over them), 9 m wide: the roads
; Plants stay off both (the scatters skip groomed ground), so the forest,
; the bushes and the grass are spread as on ISLAND 0 everywhere else.

